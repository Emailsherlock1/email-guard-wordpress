{
  "name": "emailsherlock/email-guard-wordpress",
  "description": "HostSherlock Email Guard for WordPress: blocks disposable and undeliverable email addresses at form submit across comments, registration, WooCommerce, Contact Form 7, WPForms, and Gravity Forms.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "keywords": ["wordpress", "plugin", "email", "email-validation", "email-verification", "disposable", "form-validation", "hostsherlock"],
  "homepage": "https://github.com/Emailsherlock1/email-guard-wordpress",
  "authors": [{ "name": "HostSherlock" }],
  "require": {
    "php": ">=7.4",
    "ext-json": "*"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload-dev": {
    "psr-4": {
      "HostSherlock\\EmailGuardWp\\": "includes/",
      "HostSherlock\\EmailGuardWp\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "lint:fix": "phpcbf"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
