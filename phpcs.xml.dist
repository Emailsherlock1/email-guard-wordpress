<?xml version="1.0"?>
<ruleset name="HostSherlock Email Guard">
    <description>WordPress Coding Standards for HostSherlock Email Guard</description>

    <!-- Scope: only plugin PHP files -->
    <file>.</file>
    <arg name="extensions" value="php"/>

    <!-- Exclude generated / third-party directories -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/data/*</exclude-pattern>

    <!-- Standards -->
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs"/>

    <!-- PHP version compatibility target (7.4+) -->
    <config name="testVersion" value="7.4-"/>

    <!-- Text domain must match plugin header -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="hostsherlock-email-guard"/>
        </properties>
    </rule>

    <!-- Prefix sniff: all global symbols must use one of these prefixes -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array"
                      value="hostsherlock_email_guard,HostSherlock_Email_Guard,HOSTSHERLOCK_EMAIL_GUARD"/>
        </properties>
    </rule>
</ruleset>
